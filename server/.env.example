# ConnectSphere Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database Connection
MONGO_URI=mongodb://127.0.0.1:27017/connectsphere

# JWT Secrets & Expiry
JWT_SECRET=connectsphere_jwt_super_secret_production_key_2026
JWT_EXPIRES_IN=7d

# Frontend Client URL (for CORS and Socket.io)
CLIENT_URL=http://localhost:5173

# Cloudinary Storage (Optional - fallback to local /uploads/ if unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
